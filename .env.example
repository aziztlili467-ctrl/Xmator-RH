# Copier ce fichier vers .env puis adapter les valeurs.
# Le fichier .env est ignoré par git (ne jamais le committer).

# Port HTTP du serveur (défaut : 4000)
PORT=4000

# Clé secrète de signature des jetons JWT — OBLIGATOIRE en production (NODE_ENV=production).
# Générer une clé aléatoire longue, ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changez_moi_par_une_cle_aleatoire_longue

# Mot de passe du compte super admin initial "Xmator" — utilisé uniquement si la base est vide.
# OBLIGATOIRE en production (NODE_ENV=production) : en son absence, le serveur refuse de démarrer.
# En développement, un mot de passe aléatoire est généré et affiché dans la console au premier démarrage.
ADMIN_PASSWORD=changez_moi

# Mot de passe de sécurité de la « zone de danger » (réinitialisations, etc.) — OBLIGATOIRE en production.
# Stocké uniquement hashé (bcrypt) dans la base ; peut aussi être changé plus tard depuis l'interface.
# En son absence hors production, un mot de passe aléatoire est généré une fois (affiché dans la console).
DANGER_PASSWORD=changez_moi_aussi

# Durée de validité des jetons JWT (défaut : 8h) — format jsonwebtoken (ex. 2h, 8h, 1d).
# JWT_EXPIRES=8h

# Chemin de la base SQLite (défaut : <racine du projet>/data/amicale.db)
# DB_PATH=data/amicale.db

# Origines autorisées pour CORS (séparées par des virgules).
# Vide (défaut) = aucune en-tête CORS : le client React est servi par ce même serveur.
# CORS_ORIGIN=https://mon-saas.example.com,https://autre.example.com